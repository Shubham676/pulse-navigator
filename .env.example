# ---- Required ----
NODE_ENV=production
# Long random string (40+ characters). Encrypts Amazon credentials; changing it disconnects every Amazon account.
APP_SECRET=
# Postgres connection string (set automatically by docker-compose)
DATABASE_URL=postgres://user:password@host:5432/pulse
# Set to true when the database needs SSL (most hosted Postgres)
DATABASE_SSL=false
# The public address people open, used in invite links and Amazon sign-in redirects
PUBLIC_URL=https://app.example.com

# ---- Optional ----
PORT=8080
# Set to false to stop public sign-ups (people then join only by invite)
ALLOW_SIGNUP=true
MAX_UPLOAD_MB=40
SESSION_DAYS=30
SYNC_EVERY_HOURS=6

# AI model for Copilot and the listing and keyword agents (Anthropic API)
ANTHROPIC_API_KEY=
# Or use DeepSeek for Copilot and the AI agents (model deepseek-flash). If both keys are set, AI_PROVIDER=deepseek picks it.
DEEPSEEK_API_KEY=
# Leave blank to use the default: claude-haiku-5-5 for Claude, deepseek-flash for DeepSeek.
# Do not set a Claude model name when using DeepSeek; DeepSeek rejects it.
AI_MODEL=
AI_MAX_TOKENS=900

# Amazon Selling Partner API app (Seller Central > Apps and Services > Develop Apps)
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# Only once the public app is approved by Amazon: enables "Sign in with Amazon"
AMAZON_SP_APP_ID=
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV

# Amazon Ads API app (advertising.amazon.com/API). Falls back to the LWA app above if empty.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_API_ENDPOINT=https://advertising-api-eu.amazon.com

# Razorpay for wallet top-ups (Dashboard > Account and Settings > API keys, and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shown on GST invoices. Confirm the SAC code with your CA.
COMPANY_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=
COMPANY_SAC=998314
